DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js / NextAuth. Générez une valeur longue avec: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
# true: autorise un nouvel utilisateur Google vérifié à créer son compte.
# false: seuls les e-mails déjà présents dans User peuvent se connecter.
AUTH_GOOGLE_ALLOW_SIGNUP="true"
