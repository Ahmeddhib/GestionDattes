generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Agriculteur {
  id                String       @id @default(cuid())
  code              String
  cin               String
  nom               String
  prenom            String
  telephone         String?
  adresse           String?
  nbPalmiers        Int
  superficie        Float?
  productionEstimee Float?
  regionId          String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenantId          String
  Region            Region       @relation(fields: [regionId], references: [id])
  Tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Livraison         Livraison[]
  Pesee             Pesee[]
  PretCaisse        PretCaisse[]

  @@unique([tenantId, cin])
  @@unique([tenantId, code])
  @@index([cin])
  @@index([code])
  @@index([nom])
  @@index([regionId])
  @@index([tenantId])
}

model Analyse {
  id            String      @id
  echantillonId String
  dateAnalyse   DateTime    @default(now())
  humidite      Float?
  tauxSucre     Float?
  calibre       String?
  qualite       String?
  observations  String?
  conforme      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  tenantId      String
  Echantillon   Echantillon @relation(fields: [echantillonId], references: [id])
  Tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([dateAnalyse])
  @@index([echantillonId])
  @@index([tenantId])
}

model AuditLog {
  id          String      @id
  actorId     String
  targetId    String?
  action      AuditAction
  description String?
  details     Json?
  createdAt   DateTime    @default(now())
  tenantId    String
  User        User        @relation(fields: [actorId], references: [id])
  Tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@index([targetId])
  @@index([tenantId])
}

model BonAchat {
  id                  String                @id
  numero              String
  prixKg              Float
  montant             Float
  statut              StatutBonAchat        @default(EN_ATTENTE)
  observations        String?
  livraisonId         String                @unique
  saisonId            String
  createdById         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  tenantId            String
  User                User                  @relation(fields: [createdById], references: [id])
  Livraison           Livraison             @relation(fields: [livraisonId], references: [id])
  Saison              Saison                @relation(fields: [saisonId], references: [id])
  Tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  PaiementAgriculteur PaiementAgriculteur[]

  @@unique([tenantId, numero])
  @@index([createdById])
  @@index([numero])
  @@index([saisonId])
  @@index([tenantId])
  @@index([tenantId, saisonId])
  @@index([tenantId, saisonId, statut])
}

model PaiementAgriculteur {
  id           String   @id
  montant      Float
  datePaiement DateTime @default(now())
  modePaiement String?
  observations String?
  bonAchatId   String
  saisonId     String
  createdById  String
  createdAt    DateTime @default(now())
  tenantId     String
  BonAchat     BonAchat @relation(fields: [bonAchatId], references: [id])
  Saison       Saison   @relation(fields: [saisonId], references: [id])
  User         User     @relation(fields: [createdById], references: [id])
  Tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([bonAchatId])
  @@index([createdById])
  @@index([saisonId])
  @@index([tenantId])
  @@index([datePaiement])
  @@index([tenantId, saisonId])
  @@index([tenantId, saisonId, datePaiement])
}

model EncaissementClient {
  id               String   @id
  montant          Float
  dateEncaissement DateTime @default(now())
  modePaiement     String?
  observations     String?
  venteId          String
  saisonId         String
  createdById      String
  createdAt        DateTime @default(now())
  tenantId         String
  Vente            Vente    @relation(fields: [venteId], references: [id])
  Saison           Saison   @relation(fields: [saisonId], references: [id])
  User             User     @relation(fields: [createdById], references: [id])
  Tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([venteId])
  @@index([createdById])
  @@index([saisonId])
  @@index([tenantId])
  @@index([dateEncaissement])
  @@index([tenantId, saisonId])
  @@index([tenantId, saisonId, dateEncaissement])
}

/// Une saison n'est jamais supprimée : elle est l'unité de rattachement de
/// toutes les opérations, et une campagne clôturée est un historique
/// définitif qui n'est jamais rouvert.
///
/// Contrainte non exprimable en Prisma, posée en SQL brut par la migration
/// 20260804064645_saisons_socle : index unique partiel
/// `Saison_one_open_per_tenant` sur ("tenantId") WHERE statut = 'OUVERTE',
/// qui garantit au niveau base qu'un tenant n'a jamais deux saisons ouvertes.
model Saison {
  id                  String                @id
  nom                 String
  dateDebut           DateTime
  dateFin             DateTime
  statut              StatutSaison          @default(OUVERTE)
  clotureeAt          DateTime?
  clotureeParId       String?
  tenantId            String
  createdById         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User                User                  @relation("SaisonCreatedBy", fields: [createdById], references: [id])
  // onDelete: Restrict et non le SET NULL par défaut d'une relation optionnelle :
  // « qui a clôturé cette campagne » est une information d'audit qui ne doit pas
  // s'effacer silencieusement si le compte de la personne est supprimé.
  ClotureePar         User?                 @relation("SaisonClotureePar", fields: [clotureeParId], references: [id], onDelete: Restrict)
  Vente               Vente[]
  Livraison           Livraison[]
  BonAchat            BonAchat[]
  PaiementAgriculteur PaiementAgriculteur[]
  EncaissementClient  EncaissementClient[]
  DepenseAutre        DepenseAutre[]
  StockDate           StockDate[]
  PretCaisse          PretCaisse[]
  BilanSaison         BilanSaison[]

  @@unique([tenantId, nom])
  @@index([tenantId])
  @@index([dateDebut])
  @@index([dateFin])
  @@index([statut])
  @@index([clotureeParId])
}

/// Snapshot figé des indicateurs d'une saison. Une fois créé, il n'est
/// JAMAIS recalculé ni réécrit, même si les données sous-jacentes changent
/// ensuite.
///
/// Deux natures, portées par `type` :
///   - PROVISOIRE : généré à la demande pendant que la saison est OUVERTE,
///     autant de fois que voulu. Ne verrouille rien.
///   - FINAL : créé une seule fois, dans la transaction de clôture.
/// `version` est une séquence monotone unique par saison (provisoire v1, v2,
/// … puis final vN).
///
/// Contrainte non exprimable en Prisma, posée en SQL brut par la migration
/// saisons_bilans_versionnes : index unique partiel
/// `BilanSaison_one_final_per_saison` sur ("saisonId") WHERE type = 'FINAL',
/// qui garantit au niveau base qu'une saison n'a jamais deux bilans finaux.
model BilanSaison {
  id                             String          @id
  saisonId                       String
  tenantId                       String
  type                           TypeBilanSaison @default(PROVISOIRE)
  version                        Int

  nombreLivraisons               Int
  totalQuantiteLivree            Float
  totalQuantiteAcceptee          Float

  totalAchatsMontant             Float
  quantitePayable                Float
  totalPaiementsAgriculteurs     Float
  soldeAgriculteursRestant       Float

  totalVentesQuantite            Float
  chiffreAffairesVentes          Float
  totalEncaissements             Float
  creancesClientsRestantes       Float

  totalDepensesAutres            Float

  tresorerie                     Float
  margeBrute                     Float
  margeNette                     Float

  /// Instantané PHYSIQUE de l'entrepôt du tenant au moment du calcul, toutes
  /// saisons d'origine confondues. Volontairement NON filtré par saison :
  /// c'est un solde à un instant t, pas un flux attribuable — le filtrer
  /// omettrait le report des campagnes précédentes encore en rayon.
  stockFinalParTypeDate          Json
  /// Idem pour les caisses : compte global des caisses physiquement dehors.
  stockCaisses                   Json
  /// Flux attribuable à la saison : quantité ENTRÉE en stock durant celle-ci
  /// (StockDate.saisonOrigineId). Stable pour toujours.
  /// Le @default("[]") ne sert qu'aux bilans antérieurs à cette colonne :
  /// tout nouveau snapshot renseigne les trois champs explicitement.
  stockEntreParTypeDate          Json            @default("[]")
  /// Part de ce stock encore disponible AU MOMENT DU CALCUL. Valide
  /// uniquement figée : cette valeur continue de baisser après la clôture,
  /// au fil des ventes des lots de cette saison.
  stockOrigineRestantParTypeDate Json            @default("[]")
  /// Caisses prêtées DURANT la saison (PretCaisse.saisonId).
  caissesSaison                  Json            @default("[]")

  genereAt                       DateTime        @default(now())
  genereParId                    String

  Saison                         Saison          @relation(fields: [saisonId], references: [id])
  Tenant                         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User                           User            @relation(fields: [genereParId], references: [id])

  @@unique([saisonId, version])
  @@index([tenantId])
  @@index([tenantId, saisonId])
  @@index([saisonId, type])
}

model DepenseAutre {
  id           String   @id
  libelle      String
  montant      Float
  categorie    String?
  dateDepense  DateTime @default(now())
  observations String?
  saisonId     String
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  tenantId     String
  Saison       Saison   @relation(fields: [saisonId], references: [id])
  User         User     @relation(fields: [createdById], references: [id])
  Tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([saisonId])
  @@index([tenantId])
  @@index([dateDepense])
  @@index([tenantId, saisonId])
  @@index([tenantId, saisonId, dateDepense])
}

model BonSortie {
  id             String     @id
  numero         String
  dateSortie     DateTime   @default(now())
  quantiteTotale Float
  stockId        String
  typeCaisseId   String
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  tenantId       String
  User           User       @relation(fields: [createdById], references: [id])
  StockDate      StockDate  @relation(fields: [stockId], references: [id])
  Tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  TypeCaisse     TypeCaisse @relation(fields: [typeCaisseId], references: [id])

  @@unique([tenantId, numero])
  @@index([createdById])
  @@index([dateSortie])
  @@index([numero])
  @@index([stockId])
  @@index([tenantId])
}

model Client {
  id        String   @id
  nom       String
  telephone String?
  adresse   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  tenantId  String
  Tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Vente     Vente[]

  @@index([nom])
  @@index([tenantId])
}

model Livreur {
  id         String       @id @default(cuid())
  nom        String
  telephone  String?
  cin        String?
  vehicule   String?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tenantId   String
  Tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  PretCaisse PretCaisse[]

  @@unique([tenantId, cin])
  @@index([tenantId])
  @@index([nom])
}

model Conditionnement {
  id            String     @id
  nombreCaisses Int
  poidsTotal    Float
  stockId       String
  typeCaisseId  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  tenantId      String
  StockDate     StockDate  @relation(fields: [stockId], references: [id])
  Tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  TypeCaisse    TypeCaisse @relation(fields: [typeCaisseId], references: [id])

  @@index([stockId])
  @@index([tenantId])
  @@index([typeCaisseId])
}

model Echantillon {
  id          String    @id
  code        String
  livraisonId String
  createdAt   DateTime  @default(now())
  tenantId    String
  Analyse     Analyse[]
  Livraison   Livraison @relation(fields: [livraisonId], references: [id])
  Tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([code])
  @@index([livraisonId])
  @@index([tenantId])
}

model Livraison {
  id                  String                @id
  numeroLot           String
  dateLivraison       DateTime
  quantiteLivree      Float
  quantiteAcceptee    Float
  agriculteurId       String
  saisonId            String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  tenantId            String
  BonAchat            BonAchat?
  Echantillon         Echantillon[]
  LivraisonTypeCaisse LivraisonTypeCaisse[]
  Agriculteur         Agriculteur           @relation(fields: [agriculteurId], references: [id])
  Saison              Saison                @relation(fields: [saisonId], references: [id])
  Tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Pesee               Pesee[]
  PretCaisse          PretCaisse[]
  StockDate           StockDate[]

  @@unique([tenantId, numeroLot])
  @@index([agriculteurId])
  @@index([createdAt])
  @@index([dateLivraison])
  @@index([numeroLot])
  @@index([saisonId])
  @@index([tenantId])
  @@index([tenantId, saisonId])
  @@index([tenantId, saisonId, dateLivraison])
}

model LivraisonTypeCaisse {
  id           String     @id @default(cuid())
  livraisonId  String
  typeCaisseId String
  typeDateId   String
  quantite     Int
  createdAt    DateTime   @default(now())
  Livraison    Livraison  @relation(fields: [livraisonId], references: [id], onDelete: Cascade)
  TypeCaisse   TypeCaisse @relation(fields: [typeCaisseId], references: [id])
  TypeDate     TypeDate   @relation(fields: [typeDateId], references: [id])

  @@unique([livraisonId, typeCaisseId, typeDateId])
  @@index([livraisonId])
  @@index([typeCaisseId])
  @@index([typeDateId])
}

model Pesee {
  id               String        @id @default(cuid())
  livraisonId      String
  agriculteurId    String
  typeCaisseId     String
  typeDateId       String
  tareKg           Decimal       @db.Decimal(6, 2)
  nombreCaisses    Int
  poidsBrutTotal   Decimal       @db.Decimal(8, 2)
  poidsTareTotal   Decimal       @db.Decimal(8, 2)
  poidsNetTotal    Decimal       @db.Decimal(8, 2)
  poidsBrutMoyen   Decimal       @db.Decimal(6, 2)
  poidsNetMoyen    Decimal       @db.Decimal(6, 2)
  prixKg           Float         @default(0)
  quantiteAcceptee Decimal       @default(0) @db.Decimal(8, 2)
  /// Nombre de caisses effectivement rendues au stock par le retour
  /// automatique declenche a la pesee. Sans cette trace, supprimer la
  /// livraison ne pouvait pas annuler le retour exactement : on retombait sur
  /// le nombre de caisses pesees, qui surestime des qu aucun pret n etait
  /// ouvert, et le stock devenait faux.
  caissesRetournees Int          @default(0)
  createdAt        DateTime      @default(now())
  tenantId         String
  Caisses          PeseeCaisse[]
  Livraison        Livraison     @relation(fields: [livraisonId], references: [id], onDelete: Cascade)
  Agriculteur      Agriculteur   @relation(fields: [agriculteurId], references: [id])
  TypeCaisse       TypeCaisse    @relation(fields: [typeCaisseId], references: [id])
  TypeDate         TypeDate      @relation(fields: [typeDateId], references: [id])
  Tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([livraisonId, typeCaisseId, typeDateId])
  @@index([livraisonId])
  @@index([agriculteurId])
  @@index([typeCaisseId])
  @@index([typeDateId])
  @@index([tenantId])
}

model PeseeCaisse {
  id        String  @id @default(cuid())
  peseeId   String
  poidsBrut Decimal @db.Decimal(6, 2)
  ordre     Int
  Pesee     Pesee   @relation(fields: [peseeId], references: [id], onDelete: Cascade)

  @@index([peseeId])
}

model PretCaisse {
  id             String      @id
  nombrePrete    Int
  nombreRetourne Int         @default(0)
  statut         StatutPret  @default(EN_COURS)
  datePreT       DateTime    @default(now())
  dateRetour     DateTime?
  observations   String?
  agriculteurId  String
  typeCaisseId   String
  livraisonId    String?
  livreurId      String?
  /// Saison durant laquelle le prêt a été consenti. `livraisonId` étant
  /// optionnel, un prêt autonome n'aurait sinon aucun rattachement possible.
  saisonId       String
  createdById    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  tenantId       String
  Agriculteur    Agriculteur @relation(fields: [agriculteurId], references: [id])
  User           User        @relation(fields: [createdById], references: [id])
  Livraison      Livraison?  @relation(fields: [livraisonId], references: [id])
  Livreur        Livreur?    @relation(fields: [livreurId], references: [id])
  Saison         Saison      @relation(fields: [saisonId], references: [id])
  Tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  TypeCaisse     TypeCaisse  @relation(fields: [typeCaisseId], references: [id])

  @@index([agriculteurId])
  @@index([createdById])
  @@index([livraisonId])
  @@index([livreurId])
  @@index([statut])
  @@index([tenantId])
  @@index([typeCaisseId])
  @@index([tenantId, saisonId])
  @@index([tenantId, saisonId, statut])
}

model Region {
  id          String        @id @default(cuid())
  nom         String
  code        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenantId    String
  Agriculteur Agriculteur[]
  Tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([code])
  @@index([tenantId])
}

model Role {
  id          String       @id
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  TenantUser  TenantUser[]
}

model StockDate {
  id                 String            @id
  quantite           Float
  quantiteDisponible Float
  dateEntree         DateTime          @default(now())
  typeDateId         String
  livraisonId        String
  /// Saison d'ENTRÉE du lot, héritée de sa livraison et jamais réécrite.
  /// Délibérément nommée `saisonOrigineId` et non `saisonId` : un lot entré
  /// en saison A reste attribué à A même s'il est vendu pendant la saison B.
  /// Filtrer le stock physique là-dessus donnerait un chiffre faux (cf. le
  /// commentaire de BilanSaison.stockFinalParTypeDate).
  saisonOrigineId    String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  tenantId           String
  BonSortie          BonSortie[]
  Conditionnement    Conditionnement[]
  Livraison          Livraison         @relation(fields: [livraisonId], references: [id])
  Saison             Saison            @relation(fields: [saisonOrigineId], references: [id])
  Tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  TypeDate           TypeDate          @relation(fields: [typeDateId], references: [id])
  Vente              Vente[]

  @@unique([livraisonId, typeDateId])
  @@index([dateEntree])
  @@index([livraisonId])
  @@index([tenantId])
  @@index([typeDateId])
  @@index([tenantId, saisonOrigineId])
  @@index([tenantId, saisonOrigineId, dateEntree])
}

model Tenant {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                String
  code                String                @unique
  active              Boolean               @default(true)
  address             String?
  phone               String?
  email               String?
  settings            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  Agriculteur         Agriculteur[]
  Analyse             Analyse[]
  AuditLog            AuditLog[]
  BonAchat            BonAchat[]
  BonSortie           BonSortie[]
  Client              Client[]
  Conditionnement     Conditionnement[]
  Echantillon         Echantillon[]
  Livraison           Livraison[]
  Livreur             Livreur[]
  Pesee               Pesee[]
  PretCaisse          PretCaisse[]
  Region              Region[]
  StockDate           StockDate[]
  TenantUser          TenantUser[]
  TypeCaisse          TypeCaisse[]
  TypeDate            TypeDate[]
  Vente               Vente[]
  PaiementAgriculteur PaiementAgriculteur[]
  EncaissementClient  EncaissementClient[]
  Saison              Saison[]
  DepenseAutre        DepenseAutre[]
  BilanSaison         BilanSaison[]

  @@index([active])
  @@index([code])
}

model TenantUser {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  tenantId  String
  roleId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Role      Role     @relation(fields: [roleId], references: [id])
  Tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([roleId])
  @@index([tenantId])
  @@index([userId])
}

model TypeCaisse {
  id                  String                @id
  nom                 String
  poidsKg             Float
  stockDisponible     Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  tenantId            String
  BonSortie           BonSortie[]
  Conditionnement     Conditionnement[]
  LivraisonTypeCaisse LivraisonTypeCaisse[]
  Pesee               Pesee[]
  PretCaisse          PretCaisse[]
  Tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nom])
  @@index([tenantId])
  @@index([stockDisponible])
}

model TypeDate {
  id                  String                @id
  nom                 String
  description         String?
  seuilAlerte         Float?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  tenantId            String
  LivraisonTypeCaisse LivraisonTypeCaisse[]
  Pesee               Pesee[]
  StockDate           StockDate[]
  Tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nom])
  @@index([tenantId])
}

model User {
  id                  String                @id
  name                String
  email               String                @unique
  password            String
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  AuditLog            AuditLog[]
  BonAchat            BonAchat[]
  BonSortie           BonSortie[]
  PretCaisse          PretCaisse[]
  TenantUser          TenantUser[]
  Vente               Vente[]
  PaiementAgriculteur PaiementAgriculteur[]
  EncaissementClient  EncaissementClient[]
  // Le nom de champ reste `Saison` (les relations sont nommées uniquement
  // pour lever l'ambiguïté introduite par `SaisonCloturee` — le renommer
  // casserait tous les consommateurs existants).
  Saison              Saison[]              @relation("SaisonCreatedBy")
  SaisonCloturee      Saison[]              @relation("SaisonClotureePar")
  DepenseAutre        DepenseAutre[]
  BilanSaison         BilanSaison[]

  @@index([email])
}

model Vente {
  id                 String               @id
  date               DateTime             @default(now())
  quantite           Float
  prixUnitaire       Float
  montant            Float
  statut             StatutVente          @default(EN_ATTENTE)
  clientId           String
  stockId            String
  saisonId           String
  createdById        String
  createdAt          DateTime             @default(now())
  tenantId           String
  Client             Client               @relation(fields: [clientId], references: [id])
  User               User                 @relation(fields: [createdById], references: [id])
  StockDate          StockDate            @relation(fields: [stockId], references: [id])
  Saison             Saison               @relation(fields: [saisonId], references: [id])
  Tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  EncaissementClient EncaissementClient[]

  @@index([clientId])
  @@index([createdById])
  @@index([date])
  @@index([stockId])
  @@index([saisonId])
  @@index([tenantId])
  @@index([tenantId, saisonId])
  @@index([tenantId, saisonId, date])
}

